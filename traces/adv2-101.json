{
 "exercise": "adv2-101",
 "unit": "unit17-advanced-ii",
 "title": "101: Data-Only Attacks",
 "desc": "Goal: Overflow a buffer to corrupt a non-control-data variable without touching any code pointer. Modern mitigations (stack canaries, CFI, shadow stacks) protect return addresses and function pointers. But data is still vulnerable. Here, isAdmin sits directly above buf[16] on the stack. Overflow buf to write any non-zero value into isAdmin — the program grants admin access and calls win(). No return address corruption needed. Craft a hex payload: 16 bytes of buffer fill, then at least one non-zero byte to set isAdmin.",
 "source": [
  "#include <stdio.h>",
  "",
  "void win() {",
  "    printf(\"Admin access granted!\\n\");",
  "}",
  "",
  "void vuln() {",
  "    int isAdmin = 0;",
  "    char buf[16];",
  "    gets(buf);",
  "    if (isAdmin) {",
  "        win();",
  "    } else {",
  "        printf(\"Access denied.\\n\");",
  "    }",
  "}",
  "",
  "int main() {",
  "    vuln();",
  "    return 0;",
  "}",
  "",
  "// Stack layout:",
  "// [buf 16 bytes] [isAdmin 4 bytes] [EBP] [RET]",
  "// Overflow buf → corrupt isAdmin!",
  "// No code pointer modification needed."
 ],
