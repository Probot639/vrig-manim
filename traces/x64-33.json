 "source": [
  {
   "text": "// One-Gadget (Magic Gadget)",
   "cls": "comment"
  },
  {
   "text": "// A single libc address that spawns a shell",
   "cls": "comment"
  },
  {
   "text": "",
   "cls": ""
  },
  {
   "text": "// $ one_gadget /lib/x86_64-linux-gnu/libc.so.6",
   "cls": "comment"
  },
  {
   "text": "// 0x4526a execve(\"/bin/sh\", rsp+0x30, environ)",
   "cls": "comment"
  },
  {
   "text": "//   constraints: [rsp+0x30] == NULL",
   "cls": "comment"
  },
  {
   "text": "// 0xf02a4 execve(\"/bin/sh\", rsp+0x50, environ)",
   "cls": "comment"
  },
  {
   "text": "//   constraints: [rsp+0x50] == NULL",
   "cls": "comment"
  },
  {
   "text": "",
   "cls": ""
  },
  {
   "text": "// Steps:",
   "cls": "comment"
  },
  {
   "text": "// 1. Leak a libc address",
   "cls": "comment"
  },
  {
   "text": "// 2. Calculate libc base",
   "cls": "comment"
  },
  {
   "text": "// 3. Add one_gadget offset",
   "cls": "comment"
  },
  {
   "text": "// 4. Overwrite return address",
   "cls": "comment"
  },
  {
   "text": "",
   "cls": ""
  },
  {
   "text": "mov rax, leaked_addr",
   "cls": "asm"
  },
  {
   "text": "sub rax, known_offset  ; libc_base",
   "cls": "asm"
  },
  {
   "text": "add rax, 0x4526a       ; one_gadget",
   "cls": "asm"
  },
  {
   "text": "; overwrite ret with rax → shell!",
   "cls": "asm"
  }
 ],
