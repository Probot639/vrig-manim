 "exercise": "win-41",
 "unit": "unit8-win-stack",
 "title": "41: /GS Cookie Bypass",
 "desc": "Windows uses /GS (stack cookies) to detect buffer overflows. The cookie sits between your buffer and the return address — if it changes, the program aborts before returning. But if you can leak the cookie value (shown in the symbol table), you can include the correct value in your payload and overwrite the return address undetected.",
 "mode": "input-hex",
 "vizMode": "stack",
 "winTitle": "/GS Cookie Bypassed!",
 "winMsg": "You included the correct cookie value in your payload, keeping the stack protection intact while redirecting execution. In real exploits, attackers leak the cookie via format strings, info leaks, or brute force.",
 "source": [
  "#include <stdio.h>",
  "",
  "// /GS Stack Cookie protection",
  "// Must preserve cookie while overwriting ret",
  "",
  "void win() { system(\"cmd\"); }",
  "",
  "void vuln() {",
  "    char buf[16];",
  "    gets(buf);",
  "    // canary check before return",
  "}"
