{
 "exercise": "mit-81",
 "unit": "unit15-mitigations",
 "title": "81: Stack Canaries Deep Dive",
 "desc": "Goal: Understand stack canary types and bypass the canary to redirect execution. The compiler inserts a secret value between the buffer and the saved return address. Three canary types exist: terminator (contains null, CR, LF, 0xFF to block string copies), random (generated at process start), and XOR (random XORed with frame pointer). Find the leaked canary value and preserve it while overwriting the return address to reach win().",
 "source": [
  "// Stack canary: -fstack-protector",
  "// Canary types:",
  "//   Terminator: 0x00 0x0d 0x0a 0xff",
  "//   Random: from /dev/urandom at startup",
  "//   XOR: random ^ frame_pointer",
  "#include <stdio.h>",
  "",
  "void win() {",
  "    printf(\"FLAG{canary_deep_dive}\\n\");",
  "}",
  "",
  "void vuln() {",
  "    char buf[16];",
  "    // Canary placed between buf and retaddr",
  "    printf(\"Leaked canary: %p\\n\", canary);",
  "    gets(buf);",
  "}",
  "",
  "// On function return:",
  "// if (canary != saved_canary)",
  "//     __stack_chk_fail(); // abort!"
 ],
