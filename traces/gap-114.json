 "exercise": "gap-114",
 "unit": "unit20-teaching-gaps",
 "title": "114: Partial Overwrite & ASLR Brute Force",
 "desc": "Goal: When ASLR randomizes addresses, you can still exploit by overwriting only the lowest 1-2 bytes of a return address. The bottom 12 bits (page offset) are never randomized. A 1-byte overwrite is deterministic (all 8 bits are within the page offset). A 2-byte overwrite has 4 bits of entropy (1/16 probability) since only bits 12-15 are randomized. Real exploits retry in a loop.",
 "source": [
  "// Partial overwrite — bypass ASLR",
  "// Bottom 12 bits are NOT randomized",
  "#include <string.h>",
  "",
  "void win() { /* at offset 0x???7b0 */ }",
  "void vuln() { /* ret at offset 0x???825 */ }",
  "",
  "void vuln() {",
  "    char buf[16];",
  "    read(0, buf, 24);",
  "    // Only overflows into low bytes of ret",
  "}",
  "",
  "// Attack: overwrite last 2 bytes of ret",
  "// to 0x??b0 (page offset of win)",
  "// 4 bits of ASLR entropy → 1/16 chance",
  "// Run exploit in a loop until it hits!"
 ],
