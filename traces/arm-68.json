 "arch": "arm",
 "desc": "Goal: Understand the ARM function prologue and epilogue. Prologue: PUSH {fp, lr} saves the frame pointer and return address, MOV fp, sp sets the new frame, SUB sp, sp, #N allocates local space. Epilogue: MOV sp, fp deallocates, POP {fp, lr} restores, BX lr returns. The saved LR on the stack is the target for buffer overflow attacks on ARM.",
 "source": [
  "// ARM Stack Frame",
  "// Prologue: push {fp, lr}",
  "//           mov fp, sp",
  "//           sub sp, sp, #N",
  "// Epilogue: mov sp, fp",
  "//           pop {fp, lr}",
  "//           bx lr",
  "",
  "// Stack layout (high → low):",
  "//   [fp+0]  → saved old FP",
  "//   [fp-4]  → saved LR (return addr!)",
  "//   [fp-8]  → local var x",
  "//   [fp-12] → local var y",
  "",
  "; — Prologue —",
  "push {fp, lr}",
  "mov fp, sp",
  "sub sp, sp, #16",
  "",
  "mov r0, #10",
  "str r0, [fp, #-8]   ; x = 10",
  "mov r1, #20",
  "str r1, [fp, #-12]  ; y = 20",
  "",
  "; — Epilogue —",
  "mov sp, fp",
  "pop {fp, lr}",
  "bx lr",
  "hlt"
 ],
