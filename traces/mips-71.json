 "arch": "mips",
 "desc": "Goal: Learn MIPS register naming and the special $zero register. MIPS has 32 registers: $zero (hardwired to 0), $v0-$v1 (return values), $a0-$a3 (arguments), $t0-$t9 (temporaries — caller-saved), $s0-$s7 (saved — callee-saved), $sp (stack pointer), $fp (frame pointer), $ra (return address). MIPS has no MOV instruction — use addiu $dst, $zero, imm to load a constant, or or $dst, $src, $zero to copy a register.",
 "source": [
  "# MIPS Register Conventions",
  "# $zero — always 0, writes are ignored",
  "# $v0-$v1 — function return values",
  "# $a0-$a3 — function arguments",
  "# $t0-$t9 — temporaries (caller-saved)",
  "# $s0-$s7 — saved (callee-saved)",
  "# $sp — stack pointer",
  "# $fp — frame pointer",
  "# $ra — return address (set by JAL)",
  "",
  "addiu $t0, $zero, 10    # Load 10",
  "addiu $t1, $zero, 20    # Load 20",
  "addiu $t2, $zero, -1    # Load -1",
  "addiu $zero, $zero, 42  # Write to $zero??",
  "or    $t3, $zero, $zero # Read $zero",
  "or    $t4, $zero, $t0   # Copy $t0 to $t4",
  "hlt"
 ],
