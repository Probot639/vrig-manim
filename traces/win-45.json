{
 "exercise": "win-45",
 "unit": "unit9-win-heap",
 "title": "45: Double Free",
 "desc": "Windows Segment Heap has protections against double-free, but older NT heap doesn't always catch it. This exercise simulates a double-free using the classic A-B-A pattern (free A, free B, free A): the intervening B-free prevents simple consecutive duplicate detection. Now malloc returns A twice — write win() into the function pointer. Note: This demonstrates the glibc-style A-B-A double-free concept applied to Windows heap exploitation.",
 "mode": "heap-double-free",
 "vizMode": "heap",
 "winTitle": "Double Free!",
 "winMsg": "Double-free corrupts the free list, letting you get the same chunk allocated twice for a write-what-where primitive.",
 "source": [
  "#include <stdlib.h>",
  "#include <windows.h>",
  "",
  "// Double Free on Windows",
  "// NT heap: less validation than Segment Heap",
  "",
  "struct Obj {",
  "    void (*action)();",
  "    char data[12];",
  "};",
  "",
  "void win() { system(\"cmd\"); }",
  "",
  "int main() {",
  "    Obj *a = HeapAlloc(h, 0, 16);",
  "    Obj *b = HeapAlloc(h, 0, 16);",
  "    a->action = normal;",
  "    HeapFree(h, 0, a);",
  "    HeapFree(h, 0, b);",
  "    HeapFree(h, 0, a);",
  "    // a is in free list twice!",
  "    Obj *c = HeapAlloc(h, 0, 16);",
  "    read(0, c, 16);",
  "    a->action();",
  "}"
 ],
