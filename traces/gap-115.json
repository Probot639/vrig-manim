 "exercise": "gap-115",
 "unit": "unit20-teaching-gaps",
 "title": "115: Uninitialized Memory Leak",
 "desc": "Goal: Uninitialized stack and heap memory can contain sensitive data from previous function calls or freed allocations. This exercise demonstrates how reading uninitialized buffers can leak canaries, pointers, and other secrets — a stepping stone for full exploitation.",
 "source": [
  "// Uninitialized memory info leak",
  "#include <stdio.h>",
  "#include <string.h>",
  "",
  "void setup() {",
  "    char secret[32];",
  "    memcpy(secret, canary, 4);",
  "    memcpy(secret+4, &libc_addr, 4);",
  "    // returns — secret stays on stack",
  "}",
  "",
  "void leak() {",
  "    char buf[32]; // NOT zeroed!",
  "    // buf overlaps setup()'s stack frame",
  "    write(1, buf, 32);",
  "    // Leaks whatever setup() left behind",
  "}",
  "",
  "int main() {",
  "    setup();",
  "    leak();  // prints canary + libc addr!",
  "}"
 ],
