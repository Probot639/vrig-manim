{
 "exercise": "mit-82",
 "unit": "unit15-mitigations",
 "title": "82: RELRO & GOT Overwrite",
 "desc": "Goal: Understand RELRO (Relocation Read-Only) and how it protects the Global Offset Table (GOT). With Partial RELRO, the GOT is writable -- an attacker can overwrite a GOT entry to redirect library calls. With Full RELRO, all GOT entries are resolved at load time and the GOT is marked read-only, blocking this attack.",
 "source": [
  "// GOT/PLT lazy binding & RELRO",
  "#include <stdio.h>",
  "",
  "int main() {",
  "    puts(\"hello\");",
  "    // First call: PLT stub -> GOT -> resolver",
  "    // Resolver fills GOT with real puts() addr",
  "    puts(\"world\");",
  "    // Second call: PLT -> GOT -> puts() direct",
  "    return 0;",
  "}",
  "",
  "// Partial RELRO: .got.plt is writable",
  "// Full RELRO:    .got.plt is read-only",
  "//   (-Wl,-z,relro,-z,now)"
 ],
