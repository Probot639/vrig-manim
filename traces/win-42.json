 "title": "42: CFG Challenge",
 "desc": "Control Flow Guard (CFG) validates indirect call targets. But direct return address overwrites bypass CFG — CFG only protects forward-edge calls, not backward-edge returns. Overflow the 12-byte buffer to overwrite the return address. CFG can't stop this!",
 "mode": "input-hex",
 "vizMode": "stack",
 "winTitle": "CFG Bypassed!",
 "winMsg": "CFG protects indirect calls but NOT return addresses. ROP and ret2win attacks still work even with CFG enabled.",
 "source": [
  "#include <stdio.h>",
  "#include <windows.h>",
  "",
  "// CFG — Control Flow Guard",
  "// Protects: indirect calls (call [eax])",
  "// Does NOT protect: return addresses!",
  "",
  "void win() { WinExec(\"calc\", 0); }",
  "",
  "void vuln() {",
  "    char buf[12];",
  "    gets(buf);",
  "}",
  "",
  "int main() {",
  "    vuln();",
  "    return 0;",
  "}"
