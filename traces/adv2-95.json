 "unit": "unit17-advanced-ii",
 "title": "95: JIT Spraying",
 "desc": "Goal: Understand how JIT compilers inadvertently create attacker-controlled machine code. When a JIT engine compiles JavaScript like var x = 0x3c909090 ^ 0x3c909090 ^ 0x3c909090, it emits x86 xor eax, 0x3c909090 instructions. Each is 5 bytes: 35 90 90 90 3c. Jumping one byte into the instruction reinterprets the constant bytes as code: three 0x90 NOPs followed by 0x3c (CMP AL, imm8). The attacker gets a NOP sled and can embed arbitrary shellcode in the constants. JIT pages are typically RWX (readable, writable, executable), bypassing DEP/NX entirely.",
 "mode": "asm-quiz",
 "arch": "x86",
 "source": [
  "// JIT Spray attack concept",
  "// JavaScript source:",
  "var x = 0x3c909090 ^ 0x3c909090",
  "      ^ 0x3c909090 ^ 0x3c909090;",
  "",
  "// JIT compiles each XOR to x86:",
  "// 35 90 90 90 3c  = xor eax, 0x3c909090",
  "",
  "// Aligned (intended) decode:",
  "//   xor eax, 0x3c909090",
  "",
  "// Unaligned (+1 byte) decode:",
  "//   90 = nop",
  "//   90 = nop",
  "//   90 = nop",
  "//   3c 35 = cmp al, 0x35",
  "//   90 = nop  (from next XOR constant)",
  "//   ... repeating NOP sled!"
 ],
