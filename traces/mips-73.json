 "arch": "mips",
 "desc": "Goal: Learn MIPS memory access. MIPS is a load/store architecture — you cannot operate directly on memory. You must load values into registers, operate, then store back. Addressing is always offset($reg). MIPS uses big-endian byte ordering — the most significant byte is at the lowest address. When you lb (load byte) from address N, you get the MSB of the word at that address.",
 "source": [
  "# MIPS Memory Access (Big-Endian)",
  "# $s0 = 0x10010000 (base address, preloaded)",
  "# mem[0x10010000] = 0xDEADBEEF",
  "# mem[0x10010004] = 0x00000042",
  "",
  "# Big-endian layout at 0x10010000:",
  "#   byte 0: 0xDE  (MSB first!)",
  "#   byte 1: 0xAD",
  "#   byte 2: 0xBE",
  "#   byte 3: 0xEF",
  "",
  "lw  $t0, 0($s0)     # Load full word",
  "lw  $t1, 4($s0)     # Load next word",
  "lb  $t2, 0($s0)     # Load first BYTE",
  "addiu $t3, $zero, 99",
  "sw  $t3, 8($s0)     # Store 99 to memory",
  "lw  $t4, 8($s0)     # Read it back",
  "hlt"
 ],
