 "title": "79: ASLR Deep Dive",
 "desc": "Goal: Understand Address Space Layout Randomization. ASLR randomizes the base addresses of the stack, heap, shared libraries, and (with PIE) the executable itself on each run. Typical Linux ASLR provides 28 bits of entropy for libraries and ~22 bits on 64-bit, ~19 bits on 32-bit for the stack. Without an info leak, an attacker must brute-force the randomized addresses.",
 "mode": "asm-quiz",
 "arch": "x86",
 "source": [
  "// ASLR: randomized addresses each run",
  "// Run 1:                   Run 2:",
  "// .text  0x08048000       0x08048000 (no PIE)",
  "// .data  0x0804a000       0x0804a000 (no PIE)",
  "// stack  0xbfffd000       0xbf83e000 (random!)",
  "// heap   0x0804c000       0x09a42000 (random!)",
  "// libc   0xf7d00000       0xf7a51000 (random!)",
  "",
  "// Key: without PIE, .text/.data are fixed.",
  "// With PIE + ASLR, everything moves.",
  "",
  "mov eax, 0x08048000  ; .text base",
  "mov ebx, 0x0804a000  ; .data",
  "mov ecx, 0xbfffd000  ; stack",
  "mov edx, 0x0804c000  ; heap",
  "hlt"
 ],
