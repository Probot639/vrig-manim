 "arch": "mips",
 "desc": "Goal: Understand MIPS branches and the critical branch delay slot. In MIPS, the instruction immediately after a branch or jump always executes, even when the branch is taken. This is because MIPS uses a pipeline — by the time the CPU decides to branch, it has already fetched the next instruction. This is the single most important MIPS-specific concept. Compilers often place a nop in the delay slot, but clever compilers put useful work there.",
 "source": [
  "# Branch Delay Slot — MIPS Key Concept",
  "# The instruction AFTER a branch ALWAYS executes",
  "# (even if the branch is taken!)",
  "",
  "# Pipeline reason:",
  "#   Fetch → Decode → Execute",
  "#   By the time BEQ decides to branch,",
  "#   the NEXT instruction is already fetched",
  "",
  "addiu $t0, $zero, 5",
  "addiu $t1, $zero, 5",
  "addiu $t2, $zero, 0",
  "beq   $t0, $t1, 2    # branch taken!",
  "addiu $t2, $zero, 1   # DELAY SLOT",
  "addiu $t3, $zero, 99  # skipped",
  "addiu $t4, $zero, 42  # branch target",
  "hlt"
 ],
