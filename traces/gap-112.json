 "title": "112: TOCTOU Race Condition",
 "desc": "Goal: Understand Time-of-Check to Time-of-Use (TOCTOU) race conditions. A privileged program checks file permissions with access(), then opens the file with open(). Between these two calls, an attacker can swap the file with a symlink to a sensitive target. This is a classic race condition attack.",
 "source": [
  "// TOCTOU: access() then open()",
  "#include <unistd.h>",
  "#include <fcntl.h>",
  "",
  "void read_file(char *path) {",
  "    // CHECK: does user own the file?",
  "    if (access(path, R_OK) == 0) {",
  "        /* RACE WINDOW */",
  "        // USE: open and read it",
  "        int fd = open(path, O_RDONLY);",
  "        read(fd, buf, sizeof(buf));",
  "    }",
  "}",
  "",
  "// Attacker (in parallel):",
  "// while true; do",
  "//   ln -sf /etc/shadow userfile",
  "//   ln -sf owned.txt userfile",
  "// done"
 ],
