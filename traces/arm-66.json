 "desc": "Goal: Learn ARM's signature feature: conditional execution. On ARM, almost any instruction can have a condition code suffix. MOVEQ only executes if the Zero flag is set (equal). MOVGT only if greater than. This avoids branches and keeps the pipeline full. First, CMP sets the flags, then conditional instructions check them.",
 "source": [
  "// ARM Conditional Execution",
  "// Condition codes: EQ, NE, GT, LT, GE, LE",
  "// CMP sets N, Z, C, V flags",
  "// Any instruction can be conditional!",
  "",
  "mov r0, #5",
  "mov r1, #5",
  "mov r2, #0          ; default",
  "mov r3, #0          ; default",
  "",
  "cmp r0, r1          ; 5 vs 5",
  "moveq r2, #1        ; if equal?",
  "movne r2, #0        ; if not equal?",
  "movgt r3, #99       ; if greater?",
  "",
  "mov r4, #10",
  "cmp r0, r4          ; 5 vs 10",
  "movlt r5, #1        ; if less than?",
  "movge r6, #1        ; if greater or equal?",
  "hlt"
 ],
