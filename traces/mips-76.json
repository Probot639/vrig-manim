{
 "exercise": "mips-76",
 "title": "MIPS Stack Frame",
 "unit": "unit14-mips",
 "mode": "asm-quiz",
 "vizMode": "asm-stack",
 "arch": "mips",
 "desc": "Goal: Understand the MIPS stack frame. The prologue saves $ra and $fp on the stack, then sets up a new frame. The epilogue restores them. Key insight for exploitation: the saved $ra on the stack is what a buffer overflow overwrites to hijack control flow — just like the saved return address in x86, but MIPS stores it explicitly because $ra is a register, not pushed by CALL.",
 "source": [
  "# MIPS Stack Frame Layout",
  "# $sp initially at 0x7ffffffc",
  "",
  "# After prologue (24 bytes allocated):",
  "#   20($sp) — saved $ra",
  "#   16($sp) — saved $fp",
  "#    0($sp) — local var x",
  "",
  "# --- Prologue ---",
  "addiu $sp, $sp, -24     # allocate",
  "sw    $ra, 20($sp)      # save $ra",
  "sw    $fp, 16($sp)      # save $fp",
  "or    $fp, $sp, $zero   # set frame ptr",
  "",
  "# --- Function body ---",
  "addiu $t0, $zero, 7     # x = 7",
  "sw    $t0, 0($fp)       # store on stack",
  "lw    $t1, 0($fp)       # load from stack",
  "",
  "# --- Epilogue ---",
  "or    $sp, $fp, $zero   # restore $sp",
  "lw    $ra, 20($sp)      # restore $ra",
  "lw    $fp, 16($sp)      # restore $fp",
  "addiu $sp, $sp, 24      # deallocate",
  "hlt"
 ],
