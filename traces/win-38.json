 "unit": "unit8-win-stack",
 "title": "38: Windows Stack Overflow",
 "desc": "This program has a 20-byte buffer. Overflow it to redirect execution to win(). The larger buffer means more padding bytes before you hit the return address.",
 "mode": "input-hex",
 "vizMode": "stack",
 "winTitle": "Stack Overflow!",
 "winMsg": "Whether it's ELF or PE, stack overflows work the same — overflow the buffer, overwrite the return address.",
 "source": [
  "#include <windows.h>",
  "",
  "void win() {",
  "    MessageBoxA(0, \"pwned\", \"win\", 0);",
  "}",
  "",
  "void vuln() {",
  "    char buf[20];",
  "    gets(buf);",
  "}",
  "",
  "int main() {",
  "    vuln();",
  "    return 0;",
  "}"
