 "unit": "unit16-advanced",
 "title": "91: Counterfeit OOP (COOP)",
 "desc": "Goal: Understand Counterfeit Object-Oriented Programming (COOP), an advanced code-reuse attack that chains existing virtual method calls from legitimate vtables to bypass Control-Flow Integrity (CFI). Unlike ROP which chains gadgets ending in ret, COOP chains virtual function calls (vfgadgets) that are already present in the program's vtables. Because each call goes through a legitimate vtable entry, coarse-grained CFI cannot distinguish malicious calls from normal virtual dispatch.\n\nThe assembly below simulates loading two C++ objects and resolving their virtual methods through vtable indirection. Study how the vptr is dereferenced and vtable entries are indexed.",
 "mode": "asm-quiz",
 "arch": "x86",
 "source": [
  "// COOP: Counterfeit Object-Oriented Programming",
  "// Instead of ROP gadgets, reuse virtual methods",
  "",
  "// Object layout:",
  "// obj1 @ 0x0804c000: vptr -> 0x08049000",
  "// vtable1 @ 0x08049000: [speak=0x08048100, act=0x08048200]",
  "",
  "// obj2 @ 0x0804c010: vptr -> 0x08049010",
  "// vtable2 @ 0x08049010: [gadget1=0x08048300, gadget2=0x08048400]",
  "",
  "mov ecx, 0x0804c000   ; this = obj1",
  "mov eax, [ecx]        ; load vptr",
  "mov edx, [eax]        ; vtable[0] = speak",
  "mov ebx, [eax+4]      ; vtable[1] = act",
  "mov ecx, 0x0804c010   ; this = obj2",
  "mov eax, [ecx]        ; load vptr",
  "mov esi, [eax+4]      ; vtable2[1] = gadget2",
  "hlt"
 ],
