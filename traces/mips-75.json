 "title": "MIPS Calling Convention",
 "unit": "unit14-mips",
 "mode": "asm-quiz",
 "vizMode": "asm",
 "arch": "mips",
 "desc": "Goal: Learn the MIPS calling convention. Arguments go in $a0-$a3, return values in $v0. JAL (Jump And Link) saves the return address in $ra (set to PC+8, accounting for the delay slot). JR $ra returns to the caller. Note: JAL also has a delay slot — the NOP after JAL executes before jumping to the function.",
 "source": [
  "# MIPS Calling Convention",
  "# Arguments: $a0-$a3",
  "# Return value: $v0 (and $v1 for 64-bit)",
  "# Return address: $ra (set by JAL)",
  "# JAL sets $ra = PC + 8 (past delay slot)",
  "",
  "# int add_nums(int a, int b) {",
  "#     return a + b;",
  "# }",
  "",
  "main:",
  "  addiu $a0, $zero, 10   # arg1 = 10",
  "  addiu $a1, $zero, 25   # arg2 = 25",
  "  jal   add_nums",
  "  nop                    # delay slot",
  "  or    $t0, $zero, $v0  # use return val",
  "  hlt",
  "",
  "add_nums:",
  "  add   $v0, $a0, $a1   # return a + b",
  "  jr    $ra             # return",
  "  nop                    # delay slot"
 ],
