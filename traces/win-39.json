{
 "exercise": "win-39",
 "unit": "unit8-win-stack",
 "title": "39: SEH on Stack",
 "desc": "Windows SEH (Structured Exception Handling) stores handler records on the stack. This exercise has an 8-byte buffer with a simulated SEH record above it (4 bytes nSEH + 4 bytes handler). The total distance to the return address is 20 bytes (8 buf + 4 nSEH + 4 handler + 4 EBP). Overflow through everything to reach the return address.",
 "mode": "input-hex",
 "vizMode": "stack",
 "winTitle": "SEH Overwritten!",
 "winMsg": "You overflowed through the SEH record to reach the return address. In real SEH exploits, you target the handler field itself.",
 "source": [
  "#include <stdio.h>",
  "",
  "// SEH handler lives ON the stack!",
  "// Stack layout:",
  "//   [buf 8 bytes]",
  "//   [nSEH ptr]  [handler ptr]",
  "//   [saved EBP]",
  "//   [ret addr]",
  "",
  "void win() { system(\"cmd\"); }",
  "",
  "void vuln() {",
  "    EXCEPTION_REGISTRATION seh;",
  "    char buf[8];",
  "    gets(buf);",
  "}"
 ],
