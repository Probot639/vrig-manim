 "overflow": {
  "label": "Buffer overflow",
  "title": "Can you become admin?",
  "description": "A program sets aside 16 bytes for your name, but forgets to check how much you type. Extra letters spill into nearby memory. That bug is called a buffer overflow.",
  "mission": "Try your name, then keep typing until the program crashes. Can you turn that crash into admin access by changing where it goes next?",
  "takeaway": "You used a buffer overflow to make the program call its admin function. The shape of your input changed where it went next.",
  "workshop": "/imagine-rit/rit-02",
  "slides": [
   {
    "id": "name",
    "start": 0,
    "title": "It starts with a name.",
    "description": "The program has 16 bytes for a name. Each letter fills one slot. A short name fits safely inside the buffer."
   },
   {
    "id": "overflow",
    "start": 0.22,
    "title": "Too much input spills over.",
    "description": "There’s no length check. After 16 bytes, the extra letters overwrite saved data. Keep going and they reach the return address."
   },
   {
    "id": "crash",
    "start": 0.45,
    "title": "The program crashes.",
    "description": "The return address tells the program where to go next. Our extra letters replaced it with an invalid address."
   },
   {
    "id": "repair",
    "start": 0.59,
    "title": "Give the overflow a destination.",
    "description": "Keep 20 bytes of padding, then replace the next 4 bytes with the address of admin(). Now the input has the right shape."
   },
   {
    "id": "admin",
    "start": 0.78,
    "title": "Guest becomes admin.",
    "description": "The same bug that caused the crash now redirects execution. The program calls its admin function instead of returning normally."
   }
  ],
