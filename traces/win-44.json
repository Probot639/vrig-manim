  "",
  "void win() { WinExec(\"calc\", 0); }",
  "",
  "int main() {",
  "    char *a = HeapAlloc(h, 0, 16);",
  "    Target *b = HeapAlloc(h, 0, 16);",
  "    b->handler = normal;",
  "    // overflow a into b",
  "    read(0, a, 32);",
  "    b->handler();",
  "}"
