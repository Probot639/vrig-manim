 "source": [
  {
   "text": "// CMP & Flags",
   "cls": "comment"
  },
  {
   "text": "// CMP a, b → computes a - b, sets flags",
   "cls": "comment"
  },
  {
   "text": "// ZF = 1 if a == b (result is zero)",
   "cls": "comment"
  },
  {
   "text": "// SF = 1 if result's sign bit is set (signed a < b is SF != OF)",
   "cls": "comment"
  },
  {
   "text": "// CF = 1 if a < b  (unsigned borrow)",
   "cls": "comment"
  },
  {
   "text": "// TEST a, b → computes a AND b, sets flags",
   "cls": "comment"
  },
