{
 "exercise": "asm-06",
 "unit": "unit0-asm",
 "title": "Jumps",
 "desc": "Goal: See conditional jumps in action. This code sums 1+2+3+4+5 using a loop. JL (Jump if Less) creates the loop. JE (Jump if Equal) checks the result. Watch EIP jump backward!",
 "arch": "x86",
 "word": 4,
 "hexW": 8,
 "stackBase": 3221160448,
 "vizMode": "asm",
 "source": [
  {
   "text": "// Conditional Jumps",
   "cls": "comment"
  },
  {
   "text": "// JE/JZ  — jump if equal (ZF=1)",
   "cls": "comment"
  },
  {
   "text": "// JNE/JNZ — jump if not equal (ZF=0)",
   "cls": "comment"
  },
  {
   "text": "// JG/JNLE — jump if greater (signed)",
   "cls": "comment"
  },
  {
   "text": "// JL/JNGE — jump if less (signed)",
   "cls": "comment"
  },
  {
   "text": "// JLE/JNG — jump if less or equal",
   "cls": "comment"
  },
  {
   "text": "",
   "cls": ""
  },
  {
   "text": "mov eax, 1        ; counter",
   "cls": "asm"
  },
  {
   "text": "mov ebx, 0        ; accumulator",
   "cls": "asm"
  },
  {
   "text": "loop:",
   "cls": "label"
  },
  {
   "text": "  add ebx, eax",
   "cls": "asm"
  },
  {
   "text": "  inc eax",
   "cls": "asm"
  },
  {
   "text": "  cmp eax, 6",
   "cls": "asm"
  },
  {
   "text": "  jl loop",
   "cls": "asm"
  },
  {
   "text": "",
   "cls": ""
  },
  {
   "text": "  cmp ebx, 15",
   "cls": "asm"
  },
  {
   "text": "  je success",
   "cls": "asm"
  },
  {
   "text": "  mov ecx, 0",
   "cls": "asm"
  },
  {
   "text": "success:",
   "cls": "label"
  },
  {
   "text": "  mov ecx, 1",
   "cls": "asm"
  },
  {
   "text": "  hlt",
   "cls": "asm"
  }
 ],
