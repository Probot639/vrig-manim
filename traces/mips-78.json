{
 "exercise": "mips-78",
 "title": "MIPS ROP",
 "unit": "unit14-mips",
 "mode": "input-hex",
 "arch": null,
 "desc": "Chain MIPS ROP gadgets to write a magic value and call win(). On MIPS, gadgets end with jr $ra instead of ret. Because MIPS uses a split instruction/data cache, injecting shellcode is unreliable — the CPU may execute stale cache instead of your injected code. This makes ROP the dominant exploitation technique on MIPS. Each gadget loads the next $ra from the stack, then jumps to it.",
 "source": [
  "/* MIPS ROP — JR $RA Gadget Chaining */",
  "",
  "/* MIPS cache coherency problem: */",
  "/*   I-cache and D-cache are separate */",
  "/*   Writing shellcode to data memory */",
  "/*   does NOT update the I-cache! */",
  "/*   So shellcode injection often fails */",
  "/*   → ROP is the primary technique */",
  "",
  "/* Gadgets (all end with jr $ra): */",
  "/* 0x00400300: lw $a0, 0($sp); */",
  "/*             lw $ra, 4($sp); jr $ra */",
  "/* 0x00400310: lw $a1, 0($sp); */",
  "/*             lw $ra, 4($sp); jr $ra */",
  "/* 0x00400320: sw $a0, 0($a1); */",
  "/*             lw $ra, 4($sp); jr $ra */",
  "",
  "int flag = 0; /* at 0x00410040 */",
  "",
  "void win() {",
  "    if (flag == 0xdeadbeef)",
  "        printf(\"FLAG{mips_rop}\\n\");",
  "}",
  "",
  "void vuln() {",
  "    char buf[16];",
  "    gets(buf);",
  "}"
 ],
 "gadgets": {
  "4195072": "lw $a0, 0($sp); lw $ra, 4($sp); jr $ra",
  "4195088": "lw $a1, 0($sp); lw $ra, 4($sp); jr $ra",
  "4195104": "sw $a0, 0($a1); lw $ra, 4($sp); jr $ra"
 },
