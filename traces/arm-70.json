{
 "exercise": "arm-70",
 "title": "ARM ROP",
 "unit": "unit13-arm",
 "mode": "input-hex",
 "arch": "arm",
 "desc": "ARM ROP (Return-Oriented Programming) works like x86 ROP, but gadgets end with BX LR or POP {pc} instead of RET. Each gadget pops values from the stack into registers, then returns control to the next gadget address on the stack. Chain the gadgets to write 0xdeadbeef to the flag address, then jump to win(). Click gadgets in the table to add them to your payload.",
 "source": [
  "#include <stdio.h>",
  "",
  "// NX enabled — no shellcode on ARM either",
  "// ARM gadgets end with POP {pc} or BX LR",
  "// Found these gadgets:",
  "// 0x00010300: pop {r0, pc}",
  "// 0x00010304: pop {r1, pc}",
  "// 0x00010308: str r0, [r1]; pop {pc}",
  "",
  "int flag_check = 0; // at 0x00020040",
  "",
  "void win() {",
  "    if (flag_check == 0xdeadbeef)",
  "        printf(\"FLAG{arm_rop_chain}\\n\");",
  "}",
  "",
  "void vuln() {",
  "    char buf[16];",
  "    gets(buf);",
  "}",
  "",
  "int main() {",
  "    vuln();",
  "    return 0;",
  "}"
 ],
