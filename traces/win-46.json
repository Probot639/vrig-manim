{
 "exercise": "win-46",
 "unit": "unit9-win-heap",
 "title": "46: WinAPI Heap UAF",
 "desc": "Custom heaps created with HeapCreate(HEAP_NO_SERIALIZE, ...) skip thread locking and may lack LFH mitigations. This is a use-after-free on a private heap — free the object, allocate a note in the same spot, write win() address to hijack the function pointer.",
 "mode": "heap-uaf",
 "vizMode": "heap",
 "winTitle": "WinAPI Heap Pwned!",
 "winMsg": "Custom heaps with HEAP_NO_SERIALIZE are easy targets — no LFH, no locking.",
 "source": [
  "#include <windows.h>",
  "",
  "// Private Heap — no LFH, no locking",
  "",
  "struct Handler {",
  "    void (*callback)();",
  "    char buf[12];",
  "};",
  "",
  "void win() { WinExec(\"calc\", 0); }",
  "",
  "int main() {",
  "    HANDLE h = HeapCreate(",
  "        HEAP_NO_SERIALIZE, 0x1000, 0);",
  "",
  "    Handler *obj = HeapAlloc(h, 0, 16);",
  "    obj->callback = safe_handler;",
  "    HeapFree(h, 0, obj);",
  "    char *note = HeapAlloc(h, 0, 16);",
  "    read(0, note, 16);",
  "    obj->callback();",
  "}"
 ],
