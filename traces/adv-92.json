{
 "exercise": "adv-92",
 "unit": "unit16-advanced",
 "title": "92: Ret2dlresolve",
 "desc": "Goal: Exploit the dynamic linker's lazy binding mechanism to call arbitrary library functions. When a program calls a library function for the first time, the PLT stub jumps to _dl_runtime_resolve, which looks up the function in the JMPREL (relocation) table using an index pushed onto the stack. Each JMPREL entry contains a symbol table index, and the symbol table entry contains an offset into the string table where the function name lives.Attack: If you control the stack, you can push a fake relocation index that points past the real JMPREL table into memory you control. There you forge a fake Elf32_Rel structure pointing to a fake Elf32_Sym, which in turn points to a fake string like \"system\". The dynamic linker follows the chain: fake reloc -> fake sym -> fake string -> resolves and calls system().Overflow the 16-byte buffer to overwrite the return address with win(), which models the ret2dlresolve control flow hijack.",
 "source": [
  "// Lazy binding: PLT -> _dl_runtime_resolve",
  "// Resolution chain:",
  "//   reloc_index -> JMPREL[i]",
  "//   JMPREL[i].r_info >> 8 -> SYMTAB[j]",
  "//   SYMTAB[j].st_name -> STRTAB + offset",
  "//   STRTAB + offset -> \"system\\0\"",
  "",
  "typedef struct {",
  "    uint32_t r_offset; // GOT slot address",
  "    uint32_t r_info;   // sym_index << 8 | type",
  "} Elf32_Rel;",
  "",
  "typedef struct {",
  "    uint32_t st_name;  // offset into STRTAB",
  "    uint32_t st_value;",
  "    uint32_t st_size;",
  "    uint8_t  st_info;",
  "    uint8_t  st_other;",
  "    uint16_t st_shndx;",
  "} Elf32_Sym;  // 16 bytes total",
  "",
  "void win() { printf(\"FLAG\\n\"); }",
  "",
  "void vuln() {",
  "    char buf[16];",
  "    read(0, buf, 256);",
  "    // Overflow -> fake reloc_index on stack",
  "    // -> forged Elf32_Rel -> forged Elf32_Sym",
  "    // -> \"system\" string -> call system()",
  "}"
 ],
