{
 "exercise": "mit-80",
 "unit": "unit15-mitigations",
 "title": "80: DEP / NX (W^X)",
 "desc": "Goal: Understand Data Execution Prevention (DEP), also called NX (No-eXecute) or W^X. Modern systems mark memory pages as either writable OR executable, never both. This prevents classic shellcode injection: even if you can write to the stack, the CPU refuses to execute instructions from it. Attackers bypass DEP using Return-Oriented Programming (ROP).",
 "source": [
  "// DEP / NX: non-executable stack",
  "// Page permissions: R=read, W=write, X=exec",
  "#include <stdio.h>",
  "#include <string.h>",
  "",
  "char shellcode[] = \"\\x31\\xc0\\x50...\";",
  "",
  "void vuln() {",
  "    char buf[64];",
  "    gets(buf); // overflow!",
  "    // attacker puts shellcode in buf",
  "    // overwrites ret addr to &buf",
  "}",
  "",
  "// Memory map:",
