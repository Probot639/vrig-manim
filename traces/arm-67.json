 "arch": "arm",
 "desc": "Goal: Learn the ARM calling convention (AAPCS). Arguments go in R0-R3 (not on the stack like x86!). The return value goes in R0. BL (Branch with Link) calls a function by saving the return address in LR (R14), and BX LR returns by jumping to that address. No PUSH/POP needed for simple leaf functions.",
 "source": [
  "// ARM Calling Convention (AAPCS)",
  "// R0-R3  — function arguments",
  "// R0     — return value",
  "// LR(R14)— return address (set by BL)",
  "// BX LR  — return to caller",
  "",
  "// C equivalent:",
  "// int add_values(int a, int b) {",
  "//   return a + b;",
  "// }",
  "// int main() {",
  "//   int result = add_values(12, 8);",
  "// }",
  "",
  "main:",
  "  mov r0, #12       ; arg1",
  "  mov r1, #8        ; arg2",
  "  bl add_values      ; call (saves ret addr in LR)",
  "  mov r4, r0        ; save result",
  "  hlt",
  "",
  "add_values:",
  "  add r0, r0, r1    ; return a + b in R0",
  "  bx lr             ; return"
 ],
