{
 "exercise": "kern-106",
 "unit": "unit18-kernel",
 "title": "106: SMEP/SMAP Bypass",
 "desc": "Goal: Understand how SMEP (Supervisor Mode Execution Prevention) blocks jumping to user-space shellcode from ring 0, and how attackers bypass it with kernel ROP. Step through an overflow that hits SMEP, then see how a ROP chain using only kernel gadgets can disable SMEP by flipping the CR4 register or directly call commit_creds.",
 "source": [
  "#include <linux/module.h>",
  "#include <linux/uaccess.h>",
  "",
  "// CR4 register controls SMEP/SMAP:",
  "// Bit 20 = SMEP (exec protection)",
  "// Bit 21 = SMAP (read/write protection)",
  "",
  "static long vuln_ioctl(struct file *f,",
  "    unsigned int cmd, unsigned long arg) {",
  "    char kbuf[64];",
  "    copy_from_user(kbuf, (void*)arg, 256);",
  "    return 0;",
  "}",
  "",
  "// Kernel .text gadgets:",
  "// 0xc0101234: pop rdi; ret",
  "// 0xc0105678: mov cr4, rdi; ret",
  "// 0xc00a0000: commit_creds",
  "// 0xc00a0100: prepare_kernel_cred"
 ],
