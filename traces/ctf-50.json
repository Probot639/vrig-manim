 "source": [
  "// CTF Medium — Format String + Canary Bypass",
  "// Protections: Stack Canary",
  "// Buffer: 16 bytes",
  "",
  "void win() { system(\"/bin/sh\"); }",
  "",
  "void vuln() {",
  "  char buf[16];",
  "  char fmt[32];",
  "  printf(\"Fmt: \");",
  "  gets(fmt);",
  "  printf(fmt);   // format string leak!",
  "  printf(\"\\nBuf: \");",
  "  gets(buf);     // overflow with leaked canary",
  "}"
