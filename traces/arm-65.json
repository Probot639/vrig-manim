 "desc": "Goal: Learn ARM memory instructions. LDR loads a word from memory into a register. STR stores a register value to memory. Addressing uses a base register with an optional offset: LDR R0, [R1, #4] loads from address R1+4. Unlike x86, ARM can only access memory through LDR/STR — arithmetic instructions work only on registers (load-store architecture).",
 "source": [
  "// ARM Memory Access (Load-Store Architecture)",
  "// LDR Rd, [Rn]       — load from [Rn]",
  "// LDR Rd, [Rn, #off] — load from [Rn + offset]",
  "// STR Rd, [Rn, #off] — store to [Rn + offset]",
  "",
  "// Memory at 0x00020000:",
  "//   +0: 0xDEADBEEF",
  "//   +4: 0xCAFEBABE",
  "//   +8: 0x00000064 (100)",
  "",
  "mov r1, #0x00020000  ; base address",
  "ldr r0, [r1]         ; load first word",
  "ldr r2, [r1, #4]     ; load second word",
  "ldr r3, [r1, #8]     ; load third word",
  "mov r4, #0x42",
  "str r4, [r1, #12]    ; store to memory",
  "ldr r5, [r1, #12]    ; load it back",
  "hlt"
 ],
