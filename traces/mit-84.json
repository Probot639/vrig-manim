{
 "exercise": "mit-84",
 "unit": "unit15-mitigations",
 "title": "84: CFI",
 "desc": "Goal: Understand Control Flow Integrity. CFI validates that indirect branches (calls through function pointers, virtual calls, returns) transfer control only to legitimate targets. Forward-edge CFI checks indirect call/jump targets. Backward-edge CFI (shadow call stacks) validates return addresses. Together they block ROP and vtable hijacking.",
 "source": [
  "// Control Flow Integrity (CFI)",
  "// Forward-edge: indirect call validation",
  "// Backward-edge: return address validation",
  "",
  "// Without CFI:",
  "void (*fptr)(int) = target;",
  "fptr(42);  // calls whatever fptr points to",
  "",
  "// With CFI (Clang -fsanitize=cfi):",
  "void (*fptr)(int) = target;",
  "// Check: is fptr a valid (int)->void ?",
  "__cfi_check(fptr, type_id);",
  "fptr(42);  // only if check passes",
  "",
  "// Shadow call stack (backward-edge):",
  "// CALL: push ret addr to both stacks",
  "// RET: compare return addr vs shadow"
 ],
