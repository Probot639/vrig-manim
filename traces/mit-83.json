 "title": "83: PIE",
 "desc": "Goal: Understand Position-Independent Executables. A PIE binary uses RIP-relative addressing instead of absolute addresses. Combined with ASLR, the entire executable is loaded at a random base address each run. The key instruction is lea reg, [rip + offset] -- it computes addresses relative to the current instruction pointer, so the code works at any base address.",
 "mode": "asm-quiz",
 "arch": "x86-64",
 "source": [
  "// Position-Independent Executable (PIE)",
  "// Compiled with: gcc -pie -fpie",
  "",
  "// RIP-relative addressing: works at any base",
  "// lea rax, [rip + 0xff5]",
  "//   = current_rip + 0xff5",
  "//   -> always points to the right data",
  "",
  "// Absolute addressing: breaks if base moves",
  "// mov rcx, 0x55555000",
  "//   -> hardcoded! Wrong if ASLR moves us",
  "",
  "push rbp",
  "mov rbp, rsp",
  "lea rax, [rip + 0xff5]",
  "lea rbx, [rip + 0x1fee]",
  "mov rcx, 0x55555000  ; bad!",
  "hlt"
 ],
