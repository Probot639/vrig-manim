 "unit": "unit8-win-stack",
 "title": "40: SEH Overwrite",
 "desc": "Classic SEH exploit! The buffer is 16 bytes inside a __try block, which places an SEH record on the stack. Overflow it to overwrite the return address with win(). The overflow corrupts the SEH handler pointer, and when the null dereference triggers an exception, the OS walks the SEH chain and dispatches through the corrupted handler. In a real SEH exploit you'd overwrite the handler field with a POP POP RET gadget address and put a short jump in nSEH, but here just reach the return address.",
 "mode": "input-hex",
 "vizMode": "stack",
 "winTitle": "SEH Exploited!",
 "winMsg": "In real Windows exploits, you'd point the handler at a POP POP RET gadget and use nSEH to jump to shellcode.",
 "source": [
  "#include <stdio.h>",
  "#include <windows.h>",
  "",
  "// Classic SEH Overwrite Pattern",
  "// Real exploit: overflow → nSEH (jmp) + handler (PPR)",
  "// Trigger exception → PPR → jmp → shellcode",
  "",
  "void win() { WinExec(\"calc\", 0); }",
  "",
  "void vuln() {",
  "    __try {",
  "        char buf[16];",
  "        gets(buf);  // overflow corrupts SEH record",
  "        *(int*)0 = 0;  // crash triggers SEH dispatch",
  "    } __except(EXCEPTION_EXECUTE_HANDLER) {}",
  "}"
